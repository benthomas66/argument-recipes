{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argument.recipes/schemas/content_item_schema.json",
  "title": "App Content Item",
  "type": "object",
  "required": [
    "canonical_id",
    "content_state",
    "publication_state",
    "question_type",
    "difficulty",
    "content_version",
    "validation_status",
    "version_state",
    "correct_answer",
    "correct_answer_job",
    "normalized_recipe_id",
    "normalized_pattern_id",
    "recipe_title",
    "stimulus",
    "question_stem",
    "diagnostic_eligible",
    "daily_repair_eligible",
    "targeted_drill_eligible",
    "review_eligible",
    "timed_eligible",
    "provenance_class",
    "difficulty_status",
    "provenance_metadata",
    "provenance_attestation",
    "provenance_evidence_refs",
    "provenance_limitations"
  ],
  "properties": {
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "content_state": {
      "enum": [
        "blueprint",
        "playable_draft",
        "playable_draft_hold",
        "validated_candidate",
        "validated"
      ]
    },
    "publication_state": {
      "enum": [
        "unpublished",
        "published",
        "retired",
        "superseded"
      ]
    },
    "question_type": {
      "enum": [
        "FL",
        "ST",
        "WK",
        "NA",
        "SA",
        "MBT",
        "MSS",
        "MC",
        "MR",
        "RC",
        "PR",
        "PA",
        "PF",
        "RP",
        "EV",
        "PI"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "validation_status": {
      "enum": [
        "production_factory_pass_not_human_validated",
        "needs_logic_repair",
        "hold_minor_review",
        "hold_surface_review",
        "blueprint_needs_repair",
        "source_decode_needs_review",
        "human_gate_validated_not_published",
        "blocked_missing_source",
        "blocked_export_failure",
        "blocked_schema_failure"
      ]
    },
    "version_state": {
      "enum": [
        "current",
        "superseded",
        "restored_candidate",
        "retired"
      ]
    },
    "correct_answer": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "correct_answer_job": {
      "type": "string",
      "minLength": 1
    },
    "normalized_recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "normalized_pattern_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_title": {
      "type": "string",
      "minLength": 1
    },
    "stimulus": {
      "type": "string",
      "minLength": 1
    },
    "question_stem": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_eligible": {
      "type": "boolean"
    },
    "daily_repair_eligible": {
      "type": "boolean"
    },
    "targeted_drill_eligible": {
      "type": "boolean"
    },
    "review_eligible": {
      "type": "boolean"
    },
    "timed_eligible": {
      "type": "boolean"
    },
    "provenance_class": {
      "enum": [
        "direct_source_blueprint",
        "multi_source_pattern",
        "taxonomy_only",
        "independently_authored"
      ]
    },
    "difficulty_status": {
      "enum": [
        "prepublication_expert_calibrated",
        "prepublication_expert_calibrated_one_sided"
      ]
    },
    "provenance_metadata": {
      "type": "object",
      "minProperties": 1
    },
    "provenance_attestation": {
      "type": "object",
      "minProperties": 1
    },
    "provenance_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"provenance_class": {"const": "taxonomy_only"}},
        "required": ["provenance_class"]
      },
      "then": {
        "properties": {
          "provenance_metadata": {
            "$ref": "provenance_record_schema.json#/$defs/taxonomyProvenanceMetadata"
          },
          "provenance_attestation": {
            "$ref": "provenance_record_schema.json#/$defs/taxonomyProvenanceAttestation"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
