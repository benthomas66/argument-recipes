{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argument.recipes/schemas/supplemental_item_version_schema.json",
  "title": "Versioned Supplemental Taxonomy Item",
  "type": "object",
  "required": ["canonical_id", "content_version", "content"],
  "properties": {
    "canonical_id": {"type": "string", "pattern": "^AR_TAX_[0-9]{4}$"},
    "content_version": {"type": "integer", "minimum": 1},
    "content": {
      "type": "object",
      "required": [
        "canonical_id", "blueprint_id", "question_type", "difficulty",
        "normalized_recipe_id", "normalized_pattern_id", "generated_variant_number",
        "recipe_title", "scenario", "stimulus",
        "question_stem", "choice_a", "choice_b", "choice_c", "choice_d",
        "choice_e", "correct_answer", "prediction_text", "correct_answer_job",
        "conclusion", "support", "gap", "inference_or_resolution", "recipe_tags",
        "diagnostic_eligible", "daily_repair_eligible", "targeted_drill_eligible",
        "review_eligible", "timed_eligible", "explanation_a",
        "explanation_b", "explanation_c", "explanation_d", "explanation_e",
        "trap_a", "trap_b", "trap_c", "trap_d", "trap_e",
        "trap_family_a", "trap_family_b", "trap_family_c", "trap_family_d",
        "trap_family_e", "provenance_class", "difficulty_status", "publication_state"
      ],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^AR_TAX_[0-9]{4}$"},
        "blueprint_id": {"type": "string", "pattern": "^AR_TAX_BP_[0-9]{4}$"},
        "question_type": {"type": "string", "minLength": 1},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
        "normalized_recipe_id": {"type": "string", "minLength": 1},
        "normalized_pattern_id": {"type": "string", "minLength": 1},
        "generated_variant_number": {"type": "integer", "minimum": 1},
        "recipe_title": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "stimulus": {"type": "string", "minLength": 1},
        "question_stem": {"type": "string", "minLength": 1},
        "choice_a": {"type": "string", "minLength": 1},
        "choice_b": {"type": "string", "minLength": 1},
        "choice_c": {"type": "string", "minLength": 1},
        "choice_d": {"type": "string", "minLength": 1},
        "choice_e": {"type": "string", "minLength": 1},
        "correct_answer": {"enum": ["A", "B", "C", "D", "E"]},
        "prediction_text": {"type": "string", "minLength": 1},
        "correct_answer_job": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1},
        "support": {"type": "string", "minLength": 1},
        "gap": {"type": "string", "minLength": 1},
        "inference_or_resolution": {"type": "string", "minLength": 1},
        "recipe_tags": {"type": "string", "minLength": 1},
        "diagnostic_eligible": {"type": "boolean"},
        "daily_repair_eligible": {"type": "boolean"},
        "targeted_drill_eligible": {"type": "boolean"},
        "review_eligible": {"type": "boolean"},
        "timed_eligible": {"type": "boolean"},
        "explanation_a": {"type": "string", "minLength": 1},
        "explanation_b": {"type": "string", "minLength": 1},
        "explanation_c": {"type": "string", "minLength": 1},
        "explanation_d": {"type": "string", "minLength": 1},
        "explanation_e": {"type": "string", "minLength": 1},
        "trap_a": {"type": "string", "minLength": 1},
        "trap_b": {"type": "string", "minLength": 1},
        "trap_c": {"type": "string", "minLength": 1},
        "trap_d": {"type": "string", "minLength": 1},
        "trap_e": {"type": "string", "minLength": 1},
        "trap_family_a": {"type": "string", "minLength": 1},
        "trap_family_b": {"type": "string", "minLength": 1},
        "trap_family_c": {"type": "string", "minLength": 1},
        "trap_family_d": {"type": "string", "minLength": 1},
        "trap_family_e": {"type": "string", "minLength": 1},
        "provenance_class": {"const": "taxonomy_only"},
        "difficulty_status": {"type": "string", "minLength": 1},
        "publication_state": {"const": "unpublished"},
        "provenance_attestation": false
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
